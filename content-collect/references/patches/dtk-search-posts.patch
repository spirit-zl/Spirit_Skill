+def test_a_withheld_search_page_is_not_the_end_of_the_list() -> None:
+    """A search block hides behind a shape that reads as "no more results".
+
+    A throttled search page comes back with an empty ``data`` list and
+    ``has_more: 0`` - byte for byte the same envelope as the genuine last page.
+    The only place that says otherwise is the sibling ``search_nil_info``
+    block, and without reading it the search truncates at whatever page the
+    platform decided to withhold, reporting a short list as if it were the
+    whole answer.
+    """
+    payload = {
+        "status_code": 0,
+        "has_more": 0,
+        "cursor": 40,
+        "data": [],
+        "log_pb": {"impr_id": "20261015181434F3AEB15EF6BAD3C0DC88"},
+        "search_nil_info": {
+            "search_nil_type": "verify_check",
+            "is_load_more": "is_load_more",
+            "search_nil_item": "verify_check",
+            "text_type": 9,
+        },
+    }
+    assert parser.detect_risk_control(payload) == "search_nil:verify_check"
+    with pytest.raises(UpstreamRiskControl) as excinfo:
+        parser.parse_search_posts(payload, fetched_at=FETCHED_AT)
+    assert excinfo.value.details["signal"] == "search_nil:verify_check"
+
+
+def test_a_search_that_found_nothing_is_still_an_honest_empty_page() -> None:
+    """The guard has to stay narrow: a keyword nobody used is not a block."""
+    payload = {"status_code": 0, "has_more": 0, "cursor": 0, "data": []}
+    assert parser.detect_risk_control(payload) is None
+    page = parser.parse_search_posts(payload, fetched_at=FETCHED_AT)
+    assert page.items == []
+    assert page.has_more is False
+    assert page.cursor is None
+
+
