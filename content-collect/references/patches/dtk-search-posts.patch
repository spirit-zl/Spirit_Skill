+def test_douyin_search_refuses_more_than_thirty() -> None:
+    """The endpoint ceiling, and that it is not the platform's.
+
+    Douyin serves 50 from its author lists, so a search route that used
+    ``max_page_size`` would accept a count this endpoint cannot serve. 31 is
+    the interesting number for the same reason 36 is on TikTok: it passes every
+    other layer's check and comes back as an empty page, which the caller reads
+    as "this keyword matched nothing".
+    """
+    assert max_search_page_size(Platform.DOUYIN) == 30
+    assert max_search_page_size(Platform.DOUYIN) < max_page_size(Platform.DOUYIN)
+
+    ceiling = max_search_page_size(Platform.DOUYIN)
+    assert resolve_count(30, maximum=ceiling) == 30
+    with pytest.raises(InvalidParam) as excinfo:
+        resolve_count(31, maximum=ceiling)
+    assert excinfo.value.details["maximum"] == 30
+    assert excinfo.value.details["value"] == 31
+
+
+def test_a_platform_without_a_search_ceiling_falls_back_to_its_own() -> None:
+    """Only Douyin serves the operation today; a new platform should inherit a
+    number measured against itself, not one measured against Douyin."""
+    assert max_search_page_size(Platform.TIKTOK) == max_page_size(Platform.TIKTOK)
