+def parse_search_posts(payload: Mapping[str, Any], *, fetched_at: datetime) -> Page[Content]:
+    """Parse ``/aweme/v1/web/general/search/single/``.
+
+    A search answer is a **mixed feed**: ``data`` holds posts, accounts, live
+    rooms and the occasional ad side by side, each tagged with a numeric
+    ``type``. Measured 2026-10-15 on a two-character Chinese keyword: 20
+    entries, 18 of them posts (``type`` 1) and 2 something else (``type`` 6).
+
+    Entries are selected by whether they carry an ``aweme_info`` rather than by
+    ``type``. The type numbering is undocumented and has moved between builds,
+    while the payload key is what the rest of this parser already reads - so
+    keying off the key survives a renumbering and keying off the number does
+    not.
+
+    Skipping the non-post entries is deliberate and is not the "quietly short
+    page" that ``docs/design/11-data-contracts.md`` forbids: the caller asked
+    for a keyword, not for a count, and "this keyword also matched three
+    accounts" is an ordinary answer rather than missing data. A page whose
+    entries are ALL non-posts comes back as an empty ``items`` with the cursor
+    intact, so paging still makes progress.
+
+    The cursor is the numeric ``offset`` of the next page (20 after the first
+    page of 20), stringified and opaque like every other cursor here. Note this
+    is an offset and not a timestamp, which is why it does not go through
+    :func:`~dtk.platforms.common.optional_id` - that helper folds ``"0"`` into
+    ``None``, and ``0`` is a legitimate offset that would be read as "no more".
+    """
+    root = _guard(payload)
+    items: list[Content] = []
+    raw = root.get("data")
+    # `data` is legitimately absent or empty on a keyword nothing matched, so
+    # this is a plain membership test rather than `root.present("data")` -
+    # which would turn "no results" into an upstream-changed bug report.
+    if isinstance(raw, Sequence) and not isinstance(raw, str):
+        for index, entry in enumerate(raw):
+            # An element that is not an object is not one of the mixed feed's
+            # kinds; it is a shape change, and `Node.children` reports it the
+            # same way rather than letting one fewer item through unnoticed.
+            if not isinstance(entry, Mapping):
+                raise UpstreamChanged(f"data[{index}]", platform=_NAME)
+            info = entry.get("aweme_info")
+            if isinstance(info, Mapping) and info:
+                path = f"data[{index}].aweme_info"
+                node = Node(info, path, _NAME)
+                items.append(content_from_node(node, fetched_at=fetched_at))
+    has_more = optional_bool(root.present("has_more"))
+    cursor = optional_str(root.get("cursor")) if has_more else None
+    if has_more and cursor is None:
+        raise root.missing("cursor")
+    return Page(items=items, cursor=cursor, has_more=has_more)
+
